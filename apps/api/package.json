{
  "name": "@anumat/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/http/app.ts"
  },
  "scripts": {
    "build": "tsx scripts/write-openapi.ts",
    "dev": "tsx watch --env-file-if-exists=../../.env src/main.ts",
    "start": "tsx --env-file-if-exists=../../.env src/main.ts",
    "demo": "tsx --env-file-if-exists=../../.env scripts/demo.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@anumat/contract": "workspace:*",
    "@anumat/core": "workspace:*",
    "@anumat/engine": "workspace:*",
    "@hono/node-server": "^2.1.1",
    "@hono/trpc-server": "0.4.2",
    "@trpc/server": "11.19.0",
    "hono": "^4.13.10",
    "trpc-to-openapi": "3.3.3",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@anumat/tsconfig": "workspace:*",
    "@types/node": "^24.0.0",
    "tsx": "^4.23.15",
    "typescript": "~5.9.3",
    "vitest": "^4.1.11"
  }
}
