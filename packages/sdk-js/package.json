{
  "name": "@anumat/js",
  "version": "1.0.1",
  "description": "Typed TypeScript client for the Anumat API.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AmitMirgal/anumat.git",
    "directory": "packages/sdk-js"
  },
  "files": [
    "dist",
    "LICENSE",
    "NOTICE",
    "README.md"
  ],
  "exports": {
    ".": "./src/index.ts"
  },
  "publishConfig": {
    "access": "public",
    "type": "module",
    "main": "./dist/index.cjs",
    "module": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "import": {
          "types": "./dist/index.d.ts",
          "default": "./dist/index.js"
        },
        "require": {
          "types": "./dist/index.d.cts",
          "default": "./dist/index.cjs"
        }
      }
    }
  },
  "scripts": {
    "prepack": "node scripts/prepare-pack.mjs",
    "postpack": "node scripts/restore-pack.mjs",
    "build": "tsup && node scripts/rewrite-dts.mjs && node scripts/check-pack.mjs",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@trpc/client": "11.19.0",
    "@trpc/server": "11.19.0"
  },
  "devDependencies": {
    "@anumat/contract": "workspace:*",
    "@anumat/tsconfig": "workspace:*",
    "@arethetypeswrong/cli": "^0.18.5",
    "@types/node": "^24.0.0",
    "tsup": "^8.5.1",
    "typescript": "~5.9.3",
    "vitest": "^4.1.11"
  }
}
