{
  "name": "@anumat/engine",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./testing": "./src/testing/index.ts"
  },
  "scripts": {
    "build": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "eval": "vitest run --config vitest.eval.config.ts",
    "db:seed": "tsx --env-file-if-exists=../../.env scripts/seed.ts",
    "watch": "tsx --env-file-if-exists=../../.env src/jobs/watch.ts",
    "context-report": "tsx scripts/context-report.ts"
  },
  "dependencies": {
    "@anumat/core": "workspace:*",
    "@anumat/db": "workspace:*",
    "@anumat/markets": "workspace:*",
    "@aws-sdk/client-s3": "^3.1156.0",
    "@firecrawl/anydoc": "^0.2.4",
    "@mastra/core": "^1.71.0",
    "pino": "^10.3.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@anumat/tsconfig": "workspace:*",
    "@mastra/evals": "^1.10.3",
    "@types/node": "^24.0.0",
    "tsx": "^4.23.15",
    "typescript": "~5.9.3",
    "vitest": "^4.1.11"
  }
}
