# Postgres URL for the API and Prisma Migrate.
DATABASE_URL=postgres://anumat:anumat@127.0.0.1:5432/anumat
TEST_DATABASE_URL=postgres://anumat:anumat@127.0.0.1:5432/anumat_test
ANUMAT_API_KEYS=dev:replace-with-a-random-string-of-16-or-more-characters

HOST=127.0.0.1
PORT=4471
LOG_LEVEL=info
RATE_LIMIT_PER_MINUTE=120

# Local disk.
ANUMAT_DATA_DIR=./data/policies
ANUMAT_STORAGE=local

# Supabase Storage.
# ANUMAT_STORAGE=s3
# ANUMAT_S3_ENDPOINT=https://abcdefghijklmnopqrst.supabase.co/storage/v1/s3
# ANUMAT_S3_REGION=us-east-1
# ANUMAT_S3_BUCKET=policies
# ANUMAT_S3_ACCESS_KEY_ID=
# ANUMAT_S3_SECRET_ACCESS_KEY=

# Google Cloud Storage, S3 interoperability.
# ANUMAT_STORAGE=s3
# ANUMAT_S3_ENDPOINT=https://storage.googleapis.com
# ANUMAT_S3_REGION=auto
# ANUMAT_S3_BUCKET=anumat-policies
# ANUMAT_S3_ACCESS_KEY_ID=
# ANUMAT_S3_SECRET_ACCESS_KEY=

ANUMAT_LLM_MODE=live
# provider/model. Defaults stay Anthropic so an existing .env keeps working.
# Google: google/gemini-2.5-pro and google/gemini-2.5-flash, with GOOGLE_API_KEY or GOOGLE_GENERATIVE_AI_API_KEY.
# Grok: xai/grok-4.3 and xai/grok-build-0.1, with XAI_API_KEY.
# Serum is not a Mastra provider. The id would be serum/<model>, and that provider is not registered.
ANUMAT_STRONG_MODEL=anthropic/claude-sonnet-4-5
ANUMAT_CHEAP_MODEL=anthropic/claude-haiku-4-5
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_API_KEY=
GOOGLE_GENERATIVE_AI_API_KEY=
XAI_API_KEY=
ANUMAT_EVAL_LIVE=

FIRECRAWL_API_KEY=
FIRECRAWL_API_URL=https://api.firecrawl.dev
