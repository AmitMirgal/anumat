{
  "name": "anumat-workspace",
  "version": "0.0.0",
  "private": true,
  "license": "SEE LICENSE IN LICENSE.md",
  "packageManager": "pnpm@12.15.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "turbo run dev --filter=@anumat/api",
    "start": "pnpm --filter @anumat/api start",
    "postinstall": "pnpm --filter @anumat/db db:generate",
    "build": "turbo run build",
    "db:generate": "pnpm --filter @anumat/db db:generate",
    "db:migrate": "pnpm --filter @anumat/db db:migrate",
    "db:seed": "pnpm --filter @anumat/engine db:seed",
    "watch": "pnpm --filter @anumat/engine watch",
    "demo": "pnpm --filter @anumat/api demo",
    "test": "turbo run test",
    "eval": "pnpm --filter @anumat/engine eval",
    "typecheck": "turbo run typecheck",
    "lint": "turbo run lint",
    "changeset": "changeset",
    "release:js": "bash scripts/release.sh js",
    "release:py": "bash scripts/release.sh py",
    "version:py": "cd packages/sdk-python && uv version --bump patch && cd ../.. && uv lock",
    "selfhost:init": "bash scripts/selfhost-init.sh",
    "selfhost:up": "docker compose up -d --build",
    "selfhost:down": "docker compose down",
    "selfhost:logs": "docker compose logs -f api"
  },
  "devDependencies": {
    "@changesets/cli": "^2.29.8",
    "turbo": "^2.6.1"
  }
}
