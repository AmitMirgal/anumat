{
  "name": "anumat",
  "version": "0.1.0",
  "private": true,
  "description": "US prior-authorization policy engine: watches payer policy PDFs, extracts versioned rules, serves approved versions over HTTP.",
  "type": "module",
  "packageManager": "pnpm@10.33.3",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/main.ts",
    "start": "tsx --env-file-if-exists=.env src/main.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx --env-file-if-exists=.env scripts/migrate.ts",
    "db:seed": "tsx --env-file-if-exists=.env scripts/seed.ts",
    "watch": "tsx --env-file-if-exists=.env src/jobs/watch.ts",
    "demo": "tsx --env-file-if-exists=.env scripts/demo.ts",
    "test": "vitest run",
    "eval": "vitest run --config vitest.eval.config.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@firecrawl/anydoc": "^0.2.4",
    "@hono/node-server": "^2.1.1",
    "@mastra/core": "^1.71.0",
    "drizzle-orm": "^0.45.3",
    "hono": "^4.13.10",
    "pino": "^10.3.1",
    "postgres": "^3.4.9",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@mastra/evals": "^1.10.3",
    "@types/node": "^24.0.0",
    "drizzle-kit": "^0.31.11",
    "tsx": "^4.23.15",
    "typescript": "~5.9.3",
    "vitest": "^4.1.11"
  },
  "pnpm": {
    "onlyBuiltDependencies": ["esbuild"]
  }
}
